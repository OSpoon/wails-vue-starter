{
  "name": "wails-vue-starter",
  "version": "0.0.2-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc --build && vite build --minify false --mode development",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "release": "bumpp"
  },
  "simple-git-hooks": {
    "preserveUnused": true,
    "pre-commit": "cd frontend && pnpm lint-staged"
  },
  "lint-staged": {
    "*.{vue,ts,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.4.0",
    "@lucide/vue": "^1.17.0",
    "@tabler/icons-vue": "^3.44.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "@wailsio/runtime": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dnd-kit-vue": "^0.0.2",
    "embla-carousel-vue": "^8.6.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.9",
    "shadcn-vue": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.5",
    "vue-input-otp": "^0.3.2",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "lint-staged": "^15.2.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "simple-git-hooks": "^2.11.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
