<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="wails-vue-starter"
        Arguments=""
        InstallLocation="C:\Program Files\OSpoon\Wails Vue Starter">
    </Installer>
    <PackageInformation
        PackageName="Wails Vue Starter"
        PackageDisplayName="Wails Vue Starter"
        PublisherName="CN=OSpoon"
        PublisherDisplayName="OSpoon"
        Version="0.1.0.0"
        PackageDescription="A wails-vue-starter application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ospoon.wails-vue-starter"
                Description="A wails-vue-starter application"
                DisplayName="Wails Vue Starter"
                ExecutableName="wails-vue-starter"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Wails Vue Starter</DisplayName>
            <PublisherDisplayName>OSpoon</PublisherDisplayName>
            <Description>A wails-vue-starter application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="wails-vue-starter.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
